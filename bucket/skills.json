{
    "version": "1.5.23",
    "description": "The open agent skills ecosystem",
    "homepage": "https://www.npmjs.com/package/skills",
    "license": "MIT",
    "depends": "nodejs22-runtime",
    "url": "https://registry.npmjs.org/skills/-/skills-1.5.23.tgz",
    "hash": "a4ddbadeedfd7aee5e1823c2037b0a313ce4017a8ff1f23b9f7fe30d52a1c963",
    "extract_dir": "package",
    "pre_install": [
        "Push-Location $dir; & \"$(Split-Path (Split-Path $dir -Parent) -Parent)\\nodejs22-runtime\\current\\npm.cmd\" install --production --no-audit --no-fund 2>&1 | Out-Null; Pop-Location",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cli.mjs`\" %*\" | Out-File -Encoding ascii \"$dir\\skills.cmd\"",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cli.mjs`\" %*\" | Out-File -Encoding ascii \"$dir\\add-skill.cmd\""
    ],
    "bin": [
        "skills.cmd",
        "add-skill.cmd"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/skills/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/skills/-/skills-$version.tgz",
        "hash": {
            "mode": "download"
        }
    }
}
