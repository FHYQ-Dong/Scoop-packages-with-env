{
    "version": "1.8.0",
    "description": "The open agent skills ecosystem",
    "homepage": "https://www.npmjs.com/package/skills",
    "license": "MIT",
    "depends": "nodejs22-runtime",
    "url": "https://registry.npmjs.org/skills/-/skills-1.8.0.tgz",
    "hash": "0085453530804834f0de662a8d538cd4dad573df0bae0654ba2d8aaf4b0f8242",
    "extract_dir": "package",
    "pre_install": [
        "$runtime = \"$(Split-Path (Split-Path $dir -Parent) -Parent)\\nodejs22-runtime\\current\"",
        "# some npm install scripts shell out to bare 'node'; this bucket keeps Node.js off PATH, so put it there for this process only",
        "$env:PATH = \"$runtime;$env:PATH\"",
        "Push-Location $dir; $log = & \"$runtime\\npm.cmd\" install --omit=dev --no-audit --no-fund 2>&1; $code = $LASTEXITCODE; Pop-Location",
        "# npm also runs the package's own 'prepare' script, which can fail on a devDependency we deliberately skipped - what matters is that the dependencies landed",
        "if (-not (Test-Path \"$dir\\node_modules\")) { $log | Write-Host; throw \"npm install failed (exit $code)\" }",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cli.mjs`\" %*\" | Out-File -Encoding ascii \"$dir\\skills.cmd\"",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cli.mjs`\" %*\" | Out-File -Encoding ascii \"$dir\\add-skill.cmd\""
    ],
    "bin": [
        "skills.cmd",
        "add-skill.cmd"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/skills/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/skills/-/skills-$version.tgz",
        "hash": {
            "mode": "download"
        }
    }
}
