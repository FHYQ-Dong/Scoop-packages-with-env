{
    "version": "1.0.0-beta.16",
    "description": "Cloudflare's official command-line interface for the Cloudflare API and Workers projects",
    "homepage": "https://developers.cloudflare.com/cf/",
    "license": "MIT OR Apache-2.0",
    "depends": "nodejs22-runtime",
    "url": "https://registry.npmjs.org/cf/-/cf-1.0.0-beta.16.tgz",
    "hash": "e75c2dde92349e91371ae654ed83cb85524dc0c0b34c9a1bcfeb0638ca0e699c",
    "extract_dir": "package",
    "pre_install": [
        "$runtime = \"$(Split-Path (Split-Path $dir -Parent) -Parent)\\nodejs22-runtime\\current\"",
        "# npm install scripts call a bare 'node'; this bucket keeps Node.js off PATH, so put it there for this process only",
        "$env:PATH = \"$runtime;$env:PATH\"",
        "# The published package includes devDependencies with unavailable workspace tarballs; remove them before resolving runtime dependencies",
        "Push-Location $dir; & \"$runtime\\npm.cmd\" pkg delete devDependencies; $deleteCode = $LASTEXITCODE; Pop-Location",
        "if ($deleteCode -ne 0) { throw \"npm pkg delete devDependencies failed (exit $deleteCode)\" }",
        "Push-Location $dir; $log = & \"$runtime\\npm.cmd\" install --omit=dev --no-save --no-package-lock --no-audit --no-fund 2>&1; $code = $LASTEXITCODE; Pop-Location",
        "if (-not (Test-Path \"$dir\\node_modules\")) { $log | Write-Host; throw \"npm install failed (exit $code)\" }",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cf`\" %*\" | Out-File -Encoding ascii \"$dir\\cf.cmd\"",
        "\"@`\"%~dp0..\\..\\nodejs22-runtime\\current\\node.exe`\" `\"%~dp0bin\\cf`\" %*\" | Out-File -Encoding ascii \"$dir\\cloudflare.cmd\""
    ],
    "bin": [
        "cf.cmd",
        "cloudflare.cmd"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/cf/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/cf/-/cf-$version.tgz",
        "hash": {
            "mode": "download"
        }
    }
}
